NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://systemforge:systemforge@127.0.0.1:5432/systemforge
PUBLIC_ORIGIN=http://localhost:4173
TRUST_PROXY=false
MAX_QUEUED_RUNS=250
MAX_RUNNING_RUNS=4
RUN_RETENTION_DAYS=30
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
WORKER_POLL_MS=500
WORKER_JOB_TIMEOUT_MS=30000

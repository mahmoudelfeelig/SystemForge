# Copy this template to a restricted location selected by the release
# controller and set mode 0600. Store the repository password in a separate
# mode-0600 file. Never commit either resolved path or credential.

# Use an independently credentialed SFTP or S3-compatible repository.
RESTIC_REPOSITORY=sftp:backup.example.invalid:systemforge

# An S3-compatible alternative uses a repository such as:
# RESTIC_REPOSITORY=s3:https://storage.example.invalid/systemforge
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

RESTIC_PASSWORD_FILE=/restricted/path/restic-password
RESTIC_CACHE_DIR=/restricted/path/cache

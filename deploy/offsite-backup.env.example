# Copy this file to /etc/systemforge/offsite-backup.env and set mode 0600.
# Store the repository password in a separate mode-0600 file. Never commit it.

# Hetzner Storage Box or another SFTP repository. Configure the SSH key,
# StrictHostKeyChecking, and keepalive behavior in the cron user's ~/.ssh/config.
RESTIC_REPOSITORY=sftp:systemforge-backup:backups/systemforge

# An S3-compatible alternative uses a repository such as:
# RESTIC_REPOSITORY=s3:https://example-account.r2.cloudflarestorage.com/systemforge-backups
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

RESTIC_PASSWORD_FILE=/etc/systemforge/restic-password
RESTIC_CACHE_DIR=/opt/systemforge-restic-cache

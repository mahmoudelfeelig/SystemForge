FROM node:24-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/sim-core/package.json packages/sim-core/package.json
RUN pnpm install --frozen-lockfile
COPY apps/worker apps/worker
COPY packages/contracts packages/contracts
COPY packages/sim-core packages/sim-core
RUN pnpm --filter @systemforge/worker build

FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /workspace/node_modules /app/node_modules
COPY --from=dependencies /workspace/apps/worker/node_modules /app/apps/worker/node_modules
COPY --from=dependencies /workspace/apps/worker/dist /app/apps/worker/dist
USER node
CMD ["node", "apps/worker/dist/index.js"]

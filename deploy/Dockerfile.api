FROM node:24-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
COPY packages/contracts packages/contracts
RUN pnpm --filter @systemforge/api build

FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /workspace/node_modules /app/node_modules
COPY --from=dependencies /workspace/apps/api/node_modules /app/apps/api/node_modules
COPY --from=dependencies /workspace/apps/api/dist /app/apps/api/dist
COPY apps/api/migrations /app/apps/api/migrations
COPY scripts/production_smoke.mjs /app/scripts/production_smoke.mjs
USER node
EXPOSE 8080
CMD ["node", "apps/api/dist/index.js"]

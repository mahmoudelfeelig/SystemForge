systemforge.elfeel.me {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	@direct_origin {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	respond @direct_origin "Cloudflare proxy required" 403

	handle /api/* {
		reverse_proxy systemforge-api:8080 {
			# Direct-origin traffic is rejected above, so this Cloudflare-only
			# header can safely drive Fastify's per-client rate limiting.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			lb_try_duration 3s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy systemforge-web:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle_errors 5xx {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store, no-transform"
		respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>SystemForge online service unavailable</title><style>*{box-sizing:border-box}html{color-scheme:dark;background:#02070b;color:#edf7fa;font-family:Arial,sans-serif}body{min-width:320px;min-height:100vh;margin:0}header{height:58px;border-bottom:1px solid #285468;background:#030a0f;display:flex;align-items:center;justify-content:space-between;padding:0 20px}header strong,header span,.label,li,dt,dd,a{font-family:Consolas,monospace;text-transform:uppercase}header strong{letter-spacing:.08em}header span{color:#ff4d3d;font-size:12px}main{width:min(1480px,100%);min-height:calc(100vh - 58px);margin:auto;border-inline:1px solid #285468;display:grid;grid-template-columns:220px minmax(0,1fr) 290px}aside{background:#050d13;padding:24px 18px}aside:first-child{border-right:1px solid #285468}aside:last-child{border-left:1px solid #285468}.label{color:#20c7ff;font-size:11px;letter-spacing:.12em}ol,dl{margin:26px 0 0;padding:0;list-style:none}li,dl div{min-height:46px;border-top:1px solid #183543;display:flex;align-items:center;justify-content:space-between;gap:10px;color:#8aa1ab;font-size:11px}li:last-child,dl div:last-child{border-bottom:1px solid #183543}.failed,.offline{color:#ff4d3d}.ready,dd{color:#4ee06f}.outage{display:grid;align-content:center;justify-items:start;padding:clamp(36px,8vw,112px);background:#030a0f}h1{max-width:720px;margin:18px 0 0;font-size:clamp(42px,5vw,70px);line-height:.98;text-transform:uppercase}p{max-width:650px;margin:18px 0 0;color:#8aa1ab;font-size:14px;line-height:1.55}.actions{margin-top:24px;display:flex;flex-wrap:wrap;gap:8px}a{min-height:40px;border:1px solid #20c7ff;background:#20c7ff;color:#02070b;display:inline-flex;align-items:center;padding:0 16px;font-size:12px;font-weight:700;text-decoration:none}.actions a+a{background:transparent;color:#20c7ff}dt,dd{margin:0;font-size:10px}dd{text-align:right}@media(max-width:840px){main{display:block;border:0}aside{border:0!important;border-bottom:1px solid #285468!important}.outage{min-height:520px;padding:44px 22px}header{padding-inline:12px}}</style></head><body><header><strong>SystemForge Lab</strong><span>Server down</span></header><main><aside><div class="label">01 / Service state</div><ol><li class="failed">Online service <b>Offline</b></li><li class="ready">Local engine <b>Available if cached</b></li><li>Retry <b>Shortly</b></li></ol></aside><section class="outage"><div class="label">Network unavailable</div><h1>The online service is offline</h1><p>Server runs, short links, and shared interviews are unavailable. If the Lab is cached, local runs still work.</p><div class="actions"><a href="/lab">Open cached Lab</a><a href="/replay">Open Replay console</a></div></section><aside><div class="label">03 / Available locally</div><dl><div><dt>Architecture drafts</dt><dd>Browser</dd></div><div><dt>Local simulation</dt><dd>Cached Lab</dd></div><div><dt>Replay files</dt><dd>Local</dd></div><div><dt>Server runs</dt><dd class="offline">Offline</dd></div><div><dt>Short links</dt><dd class="offline">Offline</dd></div></dl></aside></main></body></html>` 503
	}
}
